# ---------------------------------------------------------------------------
# Supabase (required in production)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=212639803872

# Email of the first admin user (inserted as `owner` by `npm run db:seed`)
ADMIN_EMAIL=owner@fluxmedia.ma

# ---------------------------------------------------------------------------
# Optional: mirror orders to Make / Zapier / Google Sheets
# ---------------------------------------------------------------------------
MAKE_WEBHOOK_URL=
